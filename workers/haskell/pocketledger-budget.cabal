cabal-version: 3.0
name: pocketledger-budget
version: 0.1.0.0
build-type: Simple

common settings
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat
  build-depends: base >=4.16 && <5, aeson ==2.2.3.0, bytestring, containers, scientific, text, time

library
  import: settings
  hs-source-dirs: src
  exposed-modules: BudgetEngine

executable budget-engine
  import: settings
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: pocketledger-budget
  ghc-options: -O2 -threaded

test-suite budget-tests
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends: pocketledger-budget
