{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PocketLedger Expense",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "amount_cents", "category", "note", "date"],
  "properties": {
    "id": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "amount_cents": {"type": "integer", "minimum": 1, "maximum": 100000000},
    "category": {"enum": ["food", "transport", "housing", "shopping", "health", "entertainment", "other"]},
    "note": {"type": "string", "maxLength": 140},
    "date": {"type": "string", "format": "date", "pattern": "^(20[0-9]{2}|2100)-[0-9]{2}-[0-9]{2}$"}
  }
}
